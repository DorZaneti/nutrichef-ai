# Copy this file to .env and add your actual API key

# Get your Anthropic API key at: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here



# Free key for USDA FoodData Central (accurate nutrition): https://api.data.gov/signup/
# Falls back to the rate-limited DEMO_KEY when unset.
USDA_API_KEY=your-usda-api-key-here
