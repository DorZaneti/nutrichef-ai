{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nutrichef-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && uvicorn main:app --reload --port 8000"],
      "port": 8000
    },
    {
      "name": "nutrichef-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 3000
    },
    {
      "name": "nutrichef-frontend-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run preview -- --port 3000"],
      "port": 3000
    }
  ]
}
